# Copy to .env (setup.sh does it). Values in double quotes: the Procfile sources this file with bash.

# --- Models (swap to A/B test) ---
TTS_MODEL="mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit"
STT_MODEL="mlx-community/whisper-large-v3-turbo-asr-fp16"
LLM_MODEL="mlx-community/Qwen3-8B-4bit"

# --- Voice: file name in voices/ (voices/gilfoyle.wav -> "gilfoyle") ---
VOICE="gilfoyle"

# --- Character (system prompt). /no_think turns off Qwen3's reasoning so replies start fast ---
CHARACTER_PROMPT="You are a witty, dramatic film character. Stay in character. Keep replies to 1-3 short spoken sentences, no markdown or emojis. /no_think"

# --- Ports ---
LLM_PORT="8080"
STT_PORT="8000"
TTS_PORT="8001"

# --- Tuning (defaults shown) ---
# TTS_STREAM_INTERVAL="0.64"   # seconds of audio per streamed chunk
# TTS_MAX_REF_SECONDS="20"     # longer reference clips are cut
# TTS_LOCK_WAIT="60"           # server gives up if the model is busy this long

# --- Optional ---
# HF_TOKEN=""                  # faster Hugging Face downloads
# LIVEKIT_URL=""               # only for `agent.py dev` (joining LiveKit rooms)
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""
